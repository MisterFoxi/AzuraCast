+                        @update:model-value="updateRow(index, {comparison: $event as SmartBlockCriteriaComparison})"
+                    />
+
+                    <form-group-select
+                        v-if="row.field === SmartBlockCriteriaField.Category"
+                        :id="`smart_block_category_${index}`"
+                        class="col-12 col-md-4"
